NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Backend acessado pelo proxy de admin (server-to-server). Em produção use a URL
# interna do backend; em dev pode repetir a NEXT_PUBLIC_API_URL.
INTERNAL_API_URL=http://localhost:3001/api

# Senha do login do admin.
ADMIN_PASSWORD=sulplacas2025
# Valor secreto do cookie de sessão do admin (gere uma string longa e aleatória).
ADMIN_SESSION_SECRET=change-me-use-a-long-random-string
# DEVE ser idêntico ao ADMIN_API_SECRET do backend (Render). O proxy o envia.
ADMIN_API_SECRET=change-me-use-a-long-random-string
