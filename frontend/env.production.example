# Vercel environment variables
# Set these in Vercel dashboard or using the CLI

# Database
DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Or use Prisma Data Proxy URL:
# PRISMA_DATA_PROXY_URL=prisma://... (optional)

# Admin
ADMIN_API_SECRET=replace_me_with_strong_secret
ADMIN_SESSION_SECRET=replace_session_secret
ADMIN_PASSWORD=replace_admin_password

# Frontend public vars
NEXT_PUBLIC_FRONTEND_URL=https://your-deployment.vercel.app
NEXT_PUBLIC_EMPRESA_WHATSAPP=5551999999999

# Optional
NEXT_PUBLIC_API_URL=https://your-deployment.vercel.app/api
