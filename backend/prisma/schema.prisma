// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  APPROVED
  EXPIRED
  NEGOTIATING
  LOST
}

model Client {
  id        String     @id @default(uuid())
  name      String
  whatsapp  String     @unique
  email     String?
  createdAt DateTime   @default(now()) @map("created_at")
  proposals Proposal[]

  @@map("clients")
}

model Proposal {
  id           String @id @default(uuid())
  proposalCode String @unique @map("proposal_code")
  clientId     String @map("client_id")
  client       Client @relation(fields: [clientId], references: [id])

  lengthM Float @map("length_m")
  widthM  Float @map("width_m")
  areaM2  Float @map("area_m2")

  clientCity            String @default("Porto Alegre") @map("client_city")
  displacementCostCents Int    @default(0) @map("displacement_cost_cents")
  hiddenMarginCents     Int    @default(0) @map("hidden_margin_cents")

  basePriceCents   Int @map("base_price_cents")
  excessPriceCents Int @default(0) @map("excess_price_cents")
  totalCashCents   Int @map("total_cash_cents")

  selectedUpsellIds String[] @default([]) @map("selected_upsell_ids")
  upsellTotalCents  Int      @default(0) @map("upsell_total_cents")

  validityDays  Int       @default(7) @map("validity_days")
  expiresAt     DateTime? @map("expires_at")
  internalNotes String?   @map("internal_notes")

  followupSentAt  DateTime? @map("followup_sent_at")
  followupWaLink  String?   @map("followup_wa_link")
  followupType    String?   @map("followup_type")
  hotAlertSentAt  DateTime? @map("hot_alert_sent_at")
  lastContactedAt DateTime? @map("last_contacted_at")

  status       ProposalStatus @default(DRAFT)
  viewCount    Int            @default(0) @map("view_count")
  lastViewedAt DateTime?      @map("last_viewed_at")

  views ProposalView[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("proposals")
}

model ProposalView {
  id         String   @id @default(uuid())
  proposalId String   @map("proposal_id")
  proposal   Proposal @relation(fields: [proposalId], references: [id])
  viewedAt   DateTime @default(now()) @map("viewed_at")
  userAgent  String?  @map("user_agent")
  ip         String?

  @@map("proposal_views")
}

model ExtraProduct {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  price       Int
  icon        String   @default("")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("extra_products")
}

model CityConfig {
  id               String   @id @default(uuid())
  name             String   @unique
  state            String   @default("RS")
  baseDeslocamento Int      @map("base_deslocamento")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("city_configs")
}

model PricingConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Int
  label     String   @default("")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pricing_config")
}

model UpsellProduct {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  priceCents  Int      @map("price_cents")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("upsell_products")
}

model ProposalCounter {
  id    String @id @default("singleton")
  count Int    @default(0)

  @@map("proposal_counter")
}
